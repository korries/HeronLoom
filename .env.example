# HeronLoom .env example
#
# Quick start:
# 1) Copy this file to `.env`.
# 2) Fill only the values you use.
# 3) Keep real secrets out of git.

# -----------------------------------------------------------------------------
# Heavy model (Nova, ADEPT, search)
# -----------------------------------------------------------------------------
# OpenRouter : sk-or-v1-...
# OpenAI     : sk-...
# Anthropic  : sk-ant-...
# Local model: leave blank
HEAVY_API_KEY=

# -----------------------------------------------------------------------------
# Light model (qwen3.5:9b, cluster naming)
# -----------------------------------------------------------------------------
# Runs locally via Ollama by default — leave blank.
# Only needed if you point this slot at your own remote model.
LIGHT_API_KEY=
